<launch>
  <!-- D435i standalone launch - like teleop_keyboard -->
  <arg name="enable_depth_to_laser" default="true" doc="enable depth to laser scan"/>
  <arg name="rviz" default="false" doc="start independent RVIZ for D435i"/>

  <!-- D435i driver -->
  <include file="$(find rm_ep_driver)/launch/realsense_d435i.launch"/>

  <!-- depth to LaserScan (optional) -->
  <include if="$(arg enable_depth_to_laser)" file="$(find rm_ep_driver)/launch/d435i_depth_to_laser.launch"/>

  <!-- independent RVIZ (optional, for debugging D435i) -->
  <node if="$(arg rviz)" name="d435i_rviz" pkg="rviz" type="rviz" args="-f d435i_link"/>
</launch>