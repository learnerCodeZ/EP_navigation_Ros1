<launch>
  <!-- D435i 独立启动 - 像键盘遥控一样单独运行 -->
  <arg name="camera_namespace" default="camera" doc="realsense 相机命名空间"/>
  <arg name="enable_depth_to_laser" default="true" doc="是否启动深度转激光扫描"/>
  <arg name="rviz" default="false" doc="是否启动独立 RVIZ 查看 D435i 画面"/>

  <!-- D435i 驱动 -->
  <include file="$(find rm_ep_driver)/launch/realsense_d435i.launch">
    <arg name="camera_namespace" value="$(arg camera_namespace)"/>
  </include>

  <!-- 深度转 LaserScan（可选） -->
  <include if="$(arg enable_depth_to_laser)" file="$(find rm_ep_driver)/launch/d435i_depth_to_laser.launch">
    <arg name="camera_name" value="$(arg camera_namespace)"/>
  </include>

  <!-- 独立 RVIZ（可选，用于单独调试 D435i） -->
  <node if="$(arg rviz)" name="d435i_rviz" pkg="rviz" type="rviz"
        args="-f d435i_link"/>
</launch>
