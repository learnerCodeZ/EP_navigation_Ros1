<launch>
  <!-- RealSense D435i driver - use rs_camera.launch with no args -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch"/>

  <!-- Enable pointcloud output (runs after camera node initializes) -->
  <node name="d435i_enable_pointcloud" pkg="rm_ep_driver" type="enable_pointcloud.py"
        output="screen" required="false"/>
</launch>
