<launch>
  <!-- Octomap 3D 建图：累积彩色点云(/d435i/cloud_map, map帧) → 八叉树3D地图
       效果：车移动时逐步构建3D占用地图，可查看3D结构。

       注意：用map帧点云 → octomap_server 只标occupied(无free-space rays)；
       对3D可视化足够；要做3D导航才需换回camera帧原始云+完整raycasting。

       依赖：
       - navigation.launch(use_d435i:=true) 提供 TF(map→base_link→camera)
       - cloud_to_map 起累积(accumulate:=true)
       - Jetson 先装: sudo apt install ros-noetic-octomap-server ros-noetic-octomap-rviz-plugins

       用法：在 start.launch(mode:=nav) + d435i_bringup 跑起来之后，另开终端起：
         roslaunch rm_ep_driver d435i_octomap.launch
       -->
  <arg name="cloud_topic" default="/d435i/cloud_map" doc="点云话题（已累积，map 帧）"/>
  <arg name="resolution" default="0.10" doc="八叉树分辨率(米)，越小越精细但越耗内存"/>
  <arg name="rviz" default="true" doc="是否自动弹出 RViz（关闭可手动用 Foxglove 看）"/>

  <node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
    <remap from="cloud_in" to="$(arg cloud_topic)"/>
    <param name="frame_id" value="map"/>
    <param name="resolution" value="$(arg resolution)"/>
    <!-- 高度裁剪：只取 0.05m–2m（去地板/天花板，室内合适） -->
    <param name="pointcloud_min_z" value="0.05"/>
    <param name="pointcloud_max_z" value="2.0"/>
  </node>

  <!-- RViz（预配置：map 帧 + Grid + OctoMap OccupancyGrid 显示 /octomap_full） -->
  <node if="$(arg rviz)" name="octomap_rviz" pkg="rviz" type="rviz"
        args="-d $(find rm_ep_driver)/rviz/octomap_debug.rviz" output="screen"/>
</launch>
