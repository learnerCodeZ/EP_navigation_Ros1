<launch>
  <!-- D435i 深度图 → LaserScan 转换 -->
  <arg name="scan_topic" default="/d435i/scan" doc="输出 LaserScan 话题名"/>
  <arg name="camera_name" default="camera" doc="realsense 相机命名空间"/>
  <arg name="target_frame" default="d435i_link" doc="输出扫描的 TF 帧"/>
  <arg name="scan_height" default="1" doc="扫描行数（越大覆盖越广但越慢）"/>
  <arg name="range_min" default="0.1" doc="最小有效距离"/>
  <arg name="range_max" default="10.0" doc="最大有效距离"/>

  <node name="d435i_depth_to_laserscan" pkg="depthimage_to_laserscan" type="depthimage_to_laserscan" output="screen">
    <remap from="image" to="/$(arg camera_name)/depth/image_rect_raw"/>
    <remap from="camera_info" to="/$(arg camera_name)/depth/camera_info"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="output_frame_id" value="$(arg target_frame)"/>
    <param name="scan_height" value="$(arg scan_height)"/>
    <param name="range_min" value="$(arg range_min)"/>
    <param name="range_max" value="$(arg range_max)"/>
  </node>
</launch>
